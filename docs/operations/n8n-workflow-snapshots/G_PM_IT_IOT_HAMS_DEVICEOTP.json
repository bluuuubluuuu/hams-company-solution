    {
      "parameters": {
        "jsCode": "// PairingScreen sends ?unit=<the unit id being typed>; AdminSheet sends the\n// handset's current unit, which an unprovisioned device does not have. Either\n// way the OTP must still be issued - seeding is the optional extra.\nconst raw = String(($json.query || {}).unit || '').trim();\nconst seedable = /^OC\\d{3}_H_[A-Za-z0-9]+$/.test(raw);\nreturn [{ json: { unit: seedable ? raw : null, unit_raw: raw, seedable } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        8,
        -260
      ],
      "id": "5eed0000-0000-4000-8000-000000000001",
      "name": "Parse unit"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "seed-cond-2",
              "leftValue": "={{ $json.seedable }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        208,
        -260
      ],
      "id": "5eed0000-0000-4000-8000-000000000002",
      "name": "If unit id well-formed",
      "notes": "No unit supplied, or malformed: nothing to seed. The false branch goes straight to the OTP so a code is still issued."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT EXISTS (SELECT 1 FROM \"G_PM_IT_IOT_HAMS_UNITS\" WHERE unique_id = $1) AS seeded;",
        "options": {
          "queryReplacement": "={{ $('Parse unit').item.json.unit }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        408,
        -260
      ],
      "id": "5eed0000-0000-4000-8000-000000000003",
      "name": "Already seeded?",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "id": "<CREDENTIAL_ID>",
          "name": "Postgres account"
        }
      },
      "notes": "EXISTS, not a row count. A plain SELECT returning zero rows emits zero items in n8n, which would silently kill the branch for exactly the unit that still needs seeding."
    },
    {
      "parameters": {
        "conditions": {
