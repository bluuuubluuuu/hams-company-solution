        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        808,
        -260
      ],
      "id": "5eed0000-0000-4000-8000-000000000005",
      "name": "Wialon login",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "notes": "Token filled in - same one the SEED workflow uses. 3s cap and continue-on-error: Wialon being down must never cost a technician an OTP, which also means a failure here is SILENT. The n8n execution log is the only place it shows."
    },
    {
      "parameters": {
        "url": "https://hst-api.wialon.eu/wialon/ajax.html",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "svc",
              "value": "core/search_items"
            },
            {
              "name": "params",
              "value": "={{ JSON.stringify({ spec: { itemsType: 'avl_unit', propName: 'sys_unique_id', propValueMask: $('Parse unit').item.json.unit, sortType: 'sys_unique_id' }, force: 1, flags: 257, from: 0, to: 0 }) }}"
            },
            {
              "name": "sid",
              "value": "={{ $json.eid }}"
            }
          ]
        },
        "options": {
          "timeout": 3000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1008,
        -260
      ],
      "id": "5eed0000-0000-4000-8000-000000000006",
      "name": "Wialon find this unit",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "notes": "Searches sys_unique_id for the one unit asked for, not the whole account."
    },
    {
      "parameters": {
        "jsCode": "// ALWAYS emits exactly one item, whatever Wialon did. A miss, an empty\n// body, or an error item passed through by continue-on-error must still\n// let the workflow reach the OTP - the code is what the technician is\n// waiting for, and it must not depend on Wialon answering.\nconst unit = $('Parse unit').item.json.unit;\nconst items = Array.isArray($json.items) ? $json.items : [];\nconst hit = items.find(i => String(i.uid || '') === unit) || null;\nreturn [{ json: { matched: !!hit, uid: hit ? hit.uid : null, nm: hit ? hit.nm : null } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1208,
        -260
      ],
      "id": "5eed0000-0000-4000-8000-000000000007",
      "name": "Pick exact match",
      "alwaysOutputData": true,
      "notes": "Exact uid equality, not whatever the mask returned: propValueMask accepts wildcards and a near-miss must never be seeded under the wrong id."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "seed-cond-8",
              "leftValue": "={{ $json.matched }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1408,
        -260
      ],
      "id": "5eed0000-0000-4000-8000-000000000008",
      "name": "If matched in Wialon",
      "notes": "Not licensed in Wialon yet: nothing to seed. Still issues the OTP - manual_claim will answer not_found, which is the truthful outcome."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT seed_unit($1, $2);",
        "options": {
          "queryReplacement": "={{ $json.uid }}, {{ $json.nm }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1608,
        -260
      ],
      "id": "5eed0000-0000-4000-8000-000000000009",
      "name": "Seed unit",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "id": "<CREDENTIAL_ID>",
          "name": "Postgres account"
        }
      },
      "notes": "seed_unit only inserts a new row or refreshes a name - it never touches claimed / device_fingerprint / status, so it cannot disturb a live pairing. Runs BEFORE the OTP is issued, so the row exists before anyone can type the code."
    }
