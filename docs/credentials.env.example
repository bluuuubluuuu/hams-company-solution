# credentials.env.example
# Copy this file to credentials.env (or local.properties) and fill in real values.
# NEVER commit credentials.env or local.properties to git.
# Add both to .gitignore immediately.

# Wialon API Token (72 characters, fl=-1, unlimited duration)
WIALON_TOKEN=<your_72_char_token_here>

# Wialon IPS Connection
IPS_HOST=185.213.1.24
IPS_PORT=20332

# Test unit (use for Phase 4 integration testing only)
TEST_UNIT_ID=601602811
TEST_UNIT_UNIQUE_ID=HAMS_TEST_001

# Production unit unique ID template (replace XXX with actual unit number)
# DEVICE_UNIQUE_ID=OC154_H001

# Wialon API host (for curl-based tests only — not used in app at runtime)
WIALON_API_HOST=https://hst-api.wialon.eu
WIALON_WEB_UI=https://pro.navi-agnostics.com
