# ==== Claude Code per-developer settings (local only) ====
# settings.local.json holds developer-specific Bash permission allowlists
# (e.g. `Bash(python3 *)`). Committing it would expand the repo's automation
# trust boundary for every contributor's Claude workflows. Per-dev only.
.claude/settings.local.json

# Local artefacts from field-verify runs (logcat captures, PowerShell quirks)
*_logcat.txt
hams.db*
$null

# ==== Local-only working directory (never published from this repo) ====
# Scratch area for work-in-progress that must not ship in this repo.
_local/

# ==== Archived development history (local reference only; never published) ====
HAMS_archive/

# ==== Local agent context (deliberately untracked; see 29b2786) ====
# CLAUDE.md and CONTEXT.md are per-developer working notes, not repository
# content. They were removed from tracking on purpose - keep them local so a
# rebase or a fresh branch cannot quietly reintroduce them.
CLAUDE.md
CONTEXT.md
