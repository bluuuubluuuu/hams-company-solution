<?xml version="1.0" encoding="utf-8"?>
<!--
  Permit cleartext (HTTP) ONLY to loopback hosts, for testing against a local
  n8n provisioning backend over `adb reverse` (127.0.0.1) or an emulator
  (10.0.2.2). All other traffic stays HTTPS-only by default, so production
  (deployed HTTPS endpoints) is unaffected.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
